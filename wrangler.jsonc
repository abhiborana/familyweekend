{
  "name": "taash",
  "main": "party/gameRoom.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "Main", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
